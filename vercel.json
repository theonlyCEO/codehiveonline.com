{
  "version": 2,
  "name": "codehive-online",
  "buildCommand": "echo 'No build needed'",
  "outputDirectory": ".",
  "devCommand": "echo 'Static site'",
  "installCommand": "echo 'No dependencies to install'",
  
  "routes": [
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/index.html",
      "dest": "/index.html"
    },
    {
      "src": "/contact.html",
      "dest": "/contact.html"
    },
    {
      "src": "/service.html",
      "dest": "/service.html"
    },
    {
      "src": "/industries.html",
      "dest": "/industries.html"
    },
    {
      "src": "/portfolio.html",
      "dest": "/portfolio.html"
    },
    {
      "src": "/gallery.html",
      "dest": "/gallery.html"
    },
    {
      "src": "/images/(.*)",
      "dest": "/images/$1"
    },
    {
      "src": "/(.*)\\.(png|jpg|jpeg|gif|svg|ico|webp)",
      "dest": "/$1.$2",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/(.*)\\.(css|js)",
      "dest": "/$1.$2",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Content-Type",
          "value": "image/png"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ],
  
  "redirects": [
    {
      "source": "/helpdesk",
      "destination": "/contact.html",
      "permanent": true
    },
    {
      "source": "/api/(.*)",
      "destination": "/contact.html",
      "permanent": true
    }
  ],
  
  "cleanUrls": true,
  
  "trailingSlash": false,
  
  "ignoreCommand": "echo 'Ignoring build step for static site'",
  
  "github": {
    "enabled": false,
    "silent": true
  }
}